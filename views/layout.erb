<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI File Assistant</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>AI File Assistant</h1>
      <p class="subtitle">Dosyalarınızı doğal dil ile arayın ve düzenleyin.</p>
    </header>

    <% if @error %>
      <div class="alert">
        <%= html_escape(@error) %>
      </div>
    <% end %>

    <% if @success %>
      <div class="alert alert-success">
        <%= html_escape(@success) %>
      </div>
    <% end %>

    <%= yield %>
  </div>
</body>
</html>
