<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI File Assistant</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="top-nav">
    <div class="nav-container">
      <div class="nav-left">
        <span class="logo">📁 AI File Assistant</span>
        <span class="logo-subtitle">AI-powered file search & organization</span>
      </div>
      <div class="nav-right">
        <span class="status-badge"><span class="status-dot"></span> AI Ready</span>
      </div>
    </div>
  </nav>

  <div class="container">
    <% if request.path_info == '/' && !@results && !@error && !@success %>
      <div class="hero">
        <h1>Find the files you need using natural language.</h1>
        <p>Dosyalarınızı doğal dil kullanarak bulun, analiz edin ve düzenleyin.</p>
      </div>
    <% end %>

    <% if @error %>
      <div class="alert alert-error">
        <strong>⚠️ Something went wrong</strong>
        <p><%= html_escape(@error) %></p>
      </div>
    <% end %>

    <% if @success %>
      <div class="alert alert-success">
        <strong>✓ File moved successfully</strong>
        <p><%= html_escape(@success) %></p>
      </div>
    <% end %>

    <%= yield %>
  </div>

  <script>
    function showLoading(event) {
      const btn = event.target.querySelector('button[type="submit"]');
      if(btn) {
        btn.innerHTML = '<span class="spinner">⟳</span> AI dosyaları analiz ediyor...';
        btn.classList.add('loading');
        // We do NOT disable the button immediately as it can prevent form submission in some browsers.
        // Instead, just change its appearance and text.
      }
    }

    async function browseFolder() {
      const btn = document.getElementById('browse-btn');
      const input = document.getElementById('folder');
      const originalText = btn.innerHTML;
      
      btn.innerHTML = '⏳ Açılıyor...';
      btn.disabled = true;

      try {
        const response = await fetch('/api/browse-folder');
        const data = await response.json();
        
        if (data.success && data.path) {
          input.value = data.path;
        } else if (!data.success && data.error === 'not_supported') {
          alert("Please enter the folder path manually.");
        } else if (!data.success && data.error !== 'canceled') {
          alert("Klasör seçilirken bir hata oluştu: " + data.error);
        }
      } catch (error) {
        alert("Klasör seçilirken bir bağlantı hatası oluştu.");
        console.error(error);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>
