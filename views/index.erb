<div class="workspace-label">AI SEARCH WORKSPACE</div>
<div class="card search-card">
  <div class="search-card-header">
    <div class="search-icon-wrapper">🔎</div>
    <h2>AI DOSYA ARAMA</h2>
  </div>
  
  <form action="/search" method="post" onsubmit="showLoading(event)">
    <div class="form-group">
      <label for="folder">Aranacak klasör</label>
      <div class="folder-input-group">
        <input type="text" id="folder" name="folder" value="<%= @folder ? html_escape(@folder) : 'C:\AI-Test' %>" placeholder="C:\Path\To\Folder" required>
        <button type="button" class="btn-secondary" id="browse-btn" onclick="browseFolder()">
          <span class="btn-icon">📁</span> Seç
        </button>
      </div>
      <small class="help-text">Windows klasör seçicisini kullanabilir veya yolu manuel olarak girebilirsiniz.</small>
    </div>
    
    <div class="form-group">
      <label for="query">Ne arıyorsunuz?</label>
      <input type="text" id="query" name="query" value="<%= @query ? html_escape(@query) : '' %>" placeholder="Örn. bitirme projesiyle ilgili dosyaları bul" required>
    </div>
    
    <div class="form-actions right-align">
      <button type="submit" class="btn-primary compact-btn">
        <span class="btn-icon">✨</span> AI ile Ara
      </button>
    </div>
  </form>
</div>

<% if @results && @results.length > 0 %>
  <div class="summary-section">
    <div class="summary-header">
      <h3>AI ARAMA SONUÇLARI</h3>
      <p class="summary-query">"<%= html_escape(@query) %>"</p>
    </div>
    <div class="summary-stats">
      <div class="stat-box">
        <span class="stat-value"><%= @total_scanned %></span>
        <span class="stat-label">İncelenen Dosya</span>
      </div>
      <div class="stat-box">
        <span class="stat-value highlight"><%= @results.length %></span>
        <span class="stat-label">İlgili Dosya</span>
      </div>
    </div>
  </div>

  <div class="results-container">
    <% @results.each do |item| %>
      <div class="card result-card">
        <div class="result-header">
          <div class="file-icon"><%= get_file_icon(item[:info][:file_name]) %></div>
          <div class="file-meta">
            <h3 class="file-name"><%= html_escape(item[:info][:file_name]) %></h3>
            <span class="file-badge"><%= item[:info][:extension].to_s.upcase.delete('.') %></span>
          </div>
        </div>
        
        <div class="reason-box">
          <div class="reason-label">✨ AI Değerlendirmesi</div>
          <div class="reason-text"><%= html_escape(item[:result]["reason"]) %></div>
        </div>

        <div class="result-footer">
          <form action="/move" method="post" class="move-form">
            <input type="hidden" name="source_path" value="<%= html_escape(item[:info][:path]) %>">
            <input type="hidden" name="file_name" value="<%= html_escape(item[:info][:file_name]) %>">
            
            <div class="target-row">
              <div class="target-input-wrapper">
                <label>📁 Hedef:</label>
                <input type="text" name="dest_folder" value="<%= html_escape(@folder) %>\Move-Target" required class="input-minimal">
              </div>
              <button type="submit" class="btn-secondary move-btn">Dosyayı Taşı</button>
            </div>
          </form>
        </div>
      </div>
    <% end %>
  </div>
<% elsif @results && @results.length == 0 %>
  <div class="empty-state">
    <div class="empty-icon">🔎</div>
    <h2>İlgili dosya bulunamadı</h2>
    <p>Arama sorgunuzu değiştirerek tekrar deneyin.</p>
  </div>
<% end %>
